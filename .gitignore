# Raw provider exports: ~880 MB across four files. Fetched by the commands in
# the README rather than committed.
data/raw/
data/processed/
data/cache/

# Derived artefacts are regenerated by the step scripts. The small CSVs that
# the report figures read are kept, since the figures must be reproducible
# without re-running the long jobs.
data/artifacts/*.joblib
data/artifacts/*.npy
data/artifacts/*.parquet

.venv/
__pycache__/
*.pyc
report/*.aux
report/*.log
report/*.out
.DS_Store

# Superseded deliverable: the .docx report predates the frozen evaluation and
# still carries claims that were withdrawn. The current report is report/.
*.docx
~$*

# Local editor/session config; removed from the published repo.
.claude/
